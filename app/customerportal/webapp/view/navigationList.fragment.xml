<NavigationListItem  xmlns="sap.tnt"
    text="{title}"
    icon="{icon}"
    enabled="{enabled}"
    expanded="{expanded}"
    key="{key}"
    items="{path: 'subItems', templateShareable: true}" >
    <!-- Recursive binding for nested items -->
    <NavigationListItem
        text="{title}"
        key="{key}"
        enabled="{enabled}" />
</NavigationListItem>