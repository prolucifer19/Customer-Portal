                                        width="100%"
                                        class="sapUiSmallMarginBegin"
                                    >
                                        <VBox id="conAmdVBoxCustomerNo" width="45%">
                                            <Label
                                                id="conAmdLabelCustomerNo"
                                                text="Customer No"
                                                textDirection="LTR"
                                                required="true"
                                                class="sapUiMediumMarginBegin sapUiSmallMarginEnd"
                                            />
                                            <Input
                                                id="conAmdInputCustomerNo"
                                                width="100%"
                                                editable="false"
                                                class="sapUiMediumMarginBegin sapUiSmallMarginBottom sapUiSmallMarginEnd"
                                                value="1100000003"
