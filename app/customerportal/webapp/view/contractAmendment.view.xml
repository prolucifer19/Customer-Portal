                                            <Input
                                                id="conAmdDPDCQInput"
                                                width="100px"
                                                value=""
                                                editable="true"
                                            />
                                            <!-- Redelivery Point -->
                                            <Input
                                                id="conAmdRedelivery_id"
                                                width="100px"
                                                showValueHelp="true"
                                                valueHelpRequest="onReDelivery"
                                                valueHelpOnly="true"
                                                change="CUSPoservCatDetail2"
                                            />
                                            <!--RDP Description-->
                                            <Input
                                                id="conAmdRdpdescInput"
                                                visible="false"
                                                width="100px"
                                                value=""
                                                editable="false"
                                            />
                                            <!--RDP DCQ-->
                                            <Input
                                                id="conAmdRDPDCQInput"
                                                width="100px"
                                                value=""
                                                editable="true"
                                            />
                                            <!-- Valid From DatePicker -->
                                            <DatePicker
                                                id="conAmdValidFromDatePicker"
                                                width="100px"
                                                placeholder="Select Date"
                                            />
                                            <!-- Valid To DatePicker -->
                                            <DatePicker
                                                id="conAmdValidToDatePicker"
                                                width="100px"
                                                placeholder="Select Date"
                                            />
                                            <!--Path-->
                                            <Input
                                                id="conAmdPathInput"
                                                width="100px"
                                                value=""
