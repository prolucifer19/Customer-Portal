                                            required="true"
                                            textDirection="LTR"
                                        />
                                        <DatePicker id="conAmdDatepickerValidFrom" width="200px" />
                                    </VBox>

                                    <VBox id="conAmdVbox4" width="45%">
                                        <Label
                                            id="conAmdLabelShipToParty"
                                            text="Ship To Party"
                                            required="true"
                                            textDirection="LTR"
                                        />
                                        <Input
                                            id="conAmdShipTP_id"
                                            width="200px"
                                            showValueHelp="true"
                                            valueHelpOnly="true"
                                            valueHelpRequest="onShipToParty"
                                        />
                                        <Label
                                            id="conAmdLabelContractDesc"
                                            text="Contract Description"
                                            required="true"
                                            textDirection="LTR"
                                        />
                                        <Input
                                            width="200px"
                                            id="conAmdContractDescForm1"
                                        />
                                        <Label
                                            id="conAmdLabelDivision"
                                            text="Division"
                                            required="true"
                                            textDirection="LTR"
                                        />
                                        <Input
                                            id="conAmdInputDivision"
                                            width="200px"
                                            editable="false"
                                        />
                                        <Label
                                            id="conAmdLabelValidTo"
                                            text="Valid To"
                                            required="true"
                                            textDirection="LTR"
                                        />
                                        <DatePicker id="conAmdDatepickerValidTo" width="200px" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </form:SimpleForm>


                        <!--Capacity Details -->

                        <HBox
