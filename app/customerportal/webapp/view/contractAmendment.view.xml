                                            required="true"
                                            textDirection="LTR"
                                            class="sapUiTinyMarginBegin"
                                        />
                                        <HBox id="conAmdCUSPoPlant">
                                            <Input
                                                id="conAmdCUSPoPlantID"
                                                width="200px"
                                                showValueHelp="true"
                                                valueHelpOnly="true"
                                                valueHelpRequest="onPlant"
                                                value=""
                                                required="true"
                                                change=""
                                                class="sapUiTinyMarginBegin"
                                            />
                                            <Input
                                                id="conAmdPlantDESC"
                                                width="200px"
                                                editable="false"
                                                visible="false"
                                                class="sapUiTinyMarginBegin"
                                            />
                                        </HBox>
                                        <Label
                                            id="conAmdLabelServiceProfile"
                                            text="Service Profile"
                                            required="true"
                                            textDirection="LTR"
                                            class="sapUiTinyMarginBegin"
                                        />
