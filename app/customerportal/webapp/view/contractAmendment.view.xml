                        <!-- clause information  -->

                        <!-- Main HBox to hold Left and Right sections -->
                       <Table items="{valueParameterModel>/}" mode="None" id="conAmdValueParameterTable" class="tableBorder sapUiTinyMargin">
                        <columns>
                            <Column id="conAmdColValueParameter" width="10rem">
                                <header>
                                    <Label id="conAmdTitleValueParameter" text="Value Parameter" />
                                </header>
                            </Column>
                            <Column id="conAmdColValue" width="10rem">
                                <header>
                                    <Label id="conAmdTitleValue" text="Value" required="true"/>
                                </header>
                            </Column>
                            <Column id="conAmdColTitle" width="40rem">
                                <header>
                                    <Title id="conAmdTitle" />
                                </header>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem id="conAmdColumnListItem10">
                                <cells>
                                    <Text id="conAmdServiceParameterText" text="{valueParameterModel>serviceParameter}" />
                                    <Input id="conAmdInputValue" width="100px" value="{valueParameterModel>value}" change="targetQuantityCal" required="true"/>
                                    <Label id="conAmdUomUnitDerived" text="" />
                                    <Text id="conAmdServiceParameterIDText" text="{valueParameterModel>ID}" visible="false" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                            <!-- Left Section -->
