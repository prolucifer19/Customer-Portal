                                            <Select
                                                id="conAmdServiceProfileid"
                                                width="200px"
                                                class="sapUiTinyMarginBegin"
                                            />
                                            <Input
                                                id="conAmdServiceProfileDesc"
                                                width="200px"
                                                editable="false"
                                                visible="false"
                                                class="sapUiTinyMarginBegin"
                                            />
                                        </HBox>
                                        <Label
                                            id="conAmdLabelDPTargetQuantity"
                                            text="DP Target Quantity"
                                            required="true"
                                            textDirection="LTR"
                                            class="sapUiTinyMarginBegin"
                                        />
                                        <Input
                                            id="conAmdDPTargetQuantity"
                                            width="200px"
                                            editable="false"
                                            class="sapUiTinyMarginBegin"
                                        />
                                        <Label
                                            id="conAmdLabelRDPTargetQuantity"
                                            text="RDP Target Quantity"
                                            required="true"
                                            textDirection="LTR"
                                            class="sapUiTinyMarginBegin"
                                        />
                                        <Input
                                            id="conAmdRDPTargetQuantity"
                                            width="200px"
                                            editable="false"
                                            class="sapUiTinyMarginBegin"
                                        />
                                        <Label
                                            id="conAmdLabelFuelLocation"
                                            text="Fuel Location"
                                            textDirection="LTR"
                                            class="sapUiTinyMarginBegin"
                                            visible="{= ${/fuelConsumptionEnabled} === true }"
                                        />
                                        <Input
                                            id="conAmdFuelLocation"
                                            width="200px"
                                            class="sapUiTinyMarginBegin"
                                            showValueHelp="true"
                                            valueHelpOnly="true"
                                            valueHelpRequest=""
                                            value=""
                                            visible="{= ${/fuelConsumptionEnabled} === true }"
                                        />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </form:SimpleForm>


                        <!-- add redelivery -->

                            <Table
