                                                <RadioButton
                                                    id="conAmdRadioFuelConsumption2"
                                                    text="No"
                                                    key="no"
                                                />
                                            </buttons>
                                        </RadioButtonGroup>
                                    </VBox>

                                    <VBox id="conAmdVboxMaterialBox2" width="45%">
                                        <Label
