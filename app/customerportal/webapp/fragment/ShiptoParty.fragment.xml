<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog
        id="shipToPartyId"
        noDataText="Loading..."
        title="Select Ship To Party"
        search="onSearchShiptoParty"
        confirm="onConfirmShiptoParty"
        cancel="onCancelSoldtoParty"
        items="{customerDataModel>/CustomerList}"
        growing="true"
        growingThreshold="500">

        <StandardListItem
            title="{customerDataModel>Ship_Party}"
            description="{customerDataModel>Ship_Party_Text}"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>
