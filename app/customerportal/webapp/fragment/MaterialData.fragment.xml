<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <SelectDialog
        id="materialId"
        noDataText="Loading..."
        title="Select Material"
        search="onSearchMaterial"
        confirm="onConfirmMaterial"
        cancel="onCancelMaterial"
        items="{/xGMSxMaterial_Data}"
        growing="true"
        growingThreshold="500">

        <StandardListItem
        id = "std"
            title="{Material}"
            description="{Plant Description}"
            type="Active" />
            
    </SelectDialog>
</core:FragmentDefinition>
