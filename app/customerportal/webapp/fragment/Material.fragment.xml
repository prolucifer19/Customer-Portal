<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

    <SelectDialog
        id="material"
        noDataText="No Material Found"
        title="Select Material"
        search="onValueHelpSearch7"
        liveChange="onValueHelpSearch7"
        confirm="onValueHelpClose7"
        cancel="onValueHelpClose7"
        items="{materialData>/data}">
        <StandardListItem id="_IDGenStandardListItem7"
            title="{materialData>Material}"
            description="{materialData>Desc}"
            iconDensityAware="false"
            iconInset="false"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>